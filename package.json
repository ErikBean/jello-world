{
  "name": "jello-world",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "dev:deploy": "cdk deploy --all --require-approval never -c stage=dev -c branch=$(git branch --show-current) --outputs-file cdk-outputs.dev.json",
    "dev:smoke": "node scripts/smoke.mjs cdk-outputs.dev.json",
    "dev:destroy": "cdk destroy --all --force -c stage=dev -c branch=$(git branch --show-current)"
  },
  "devDependencies": {
    "@fission-ai/openspec": "2.0.0",
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1148.1",
    "jest": "^30",
    "tsx": "^4.23.0",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@favabean/factory-cdk": "^0.2.0",
    "aws-cdk-lib": "2.277.0",
    "constructs": "^10.5.0"
  }
}
